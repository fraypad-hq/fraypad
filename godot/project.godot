; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Fraypad Godot"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=900
window/size/viewport_height=500
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=0
; The pad is laid out for a wide screen; force landscape so it never ends up
; rendered in portrait. (DisplayServer.ScreenOrientation: 0 = LANDSCAPE.)
window/handheld/orientation=0

[input_devices]

pointing/emulate_mouse_from_touch=false

[rendering]

rendering_device/driver.windows="d3d12"
; Use the GL Compatibility renderer on every platform, including the
; `mobile` (Android) override. The pad is a flat 2D UI with no 3D, and the
; mobile override has to be set explicitly: with only the base key present,
; an Android export resolves to the Vulkan "mobile" backend, whose touch
; dispatch path segfaults on some drivers (Mali-G615) as soon as a finger
; lands on the screen.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
