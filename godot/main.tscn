groups=["fraypad_client"]

; ── Gamepad controls live under one container so KBM mode can hide them ──────
;
; Layout mirrors a real Xbox 360 controller: bumpers/triggers across the top,
; the left stick in the lower-left with the d-pad just above it, and the face
; diamond above the right stick in the lower-right.
;
; The container itself just fills the screen; `main.gd::_layout_pad()` places
; every control by hand. Godot's stretch mode expands the canvas to the window
; aspect, so on a wide phone the canvas is wider than the 900x500 design size.
; Anchors alone would stretch the d-pad arms and face buttons into rectangles,
; so the code sizes each round/square control off the canvas *height* and
; centers the two clusters, which keeps every control the same shape on any
; screen instead of a different rectangle per device.

[node name="PadFit" type="Control" parent="." unique_id=981234098]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="GamepadView" type="Control" parent="PadFit" unique_id=981234099]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2

